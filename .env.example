# TOGETHER? — Environment Configuration (Discord Activity)
# Copy this file to `.env` locally. NEVER commit `.env` to Git!
# Zero paid AI API keys required.

# --- Discord Application Credentials ---
# Found in Discord Developer Portal -> Your App -> OAuth2
# Public Client ID (safe to pass to Vite frontend via VITE_ prefix)
VITE_DISCORD_CLIENT_ID=your_discord_application_client_id_here

# PRIVATE Client Secret (SERVER-SIDE ONLY — never prefix with VITE_!)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# --- Server Configuration ---
PORT=3001
HOST=127.0.0.1

# Random 32+ char secret for HMAC-signed Activity WebSocket session tokens.
# In dev, an ephemeral random secret is generated automatically if left empty.
SESSION_SECRET=change_this_to_a_random_secret_in_production

# Set to "true" ONLY for local browser dev/tests outside Discord.
# Must be "false" when validating real Discord Activity sessions.
ALLOW_DEV_AUTH=true
